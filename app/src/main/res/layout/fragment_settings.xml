<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/settings_speed_label"
            android:textSize="16sp" />

        <SeekBar
            android:id="@+id/seek_speed"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <TextView
            android:id="@+id/text_speed_value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/settings_size_label"
            android:textSize="16sp" />

        <SeekBar
            android:id="@+id/seek_size"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <TextView
            android:id="@+id/text_size_value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/settings_color_label"
            android:textSize="16sp" />

        <RadioGroup
            android:id="@+id/radio_color"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <RadioButton
                android:id="@+id/radio_color_white"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/color_white" />

            <RadioButton
                android:id="@+id/radio_color_black"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/color_black" />

            <RadioButton
                android:id="@+id/radio_color_yellow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/color_yellow" />

            <RadioButton
                android:id="@+id/radio_color_green"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/color_green" />

            <RadioButton
                android:id="@+id/radio_color_red"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/color_red" />
        </RadioGroup>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/click_key_label"
            android:textSize="16sp" />

        <RadioGroup
            android:id="@+id/radio_click_key"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <RadioButton
                android:id="@+id/radio_click_space"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/click_space" />

            <RadioButton
                android:id="@+id/radio_click_enter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/click_enter" />

            <RadioButton
                android:id="@+id/radio_click_both"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/click_both" />
        </RadioGroup>

        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/switch_auto_pause"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/auto_pause_label" />

        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/switch_control_panel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/control_panel_label" />

        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/switch_snap_to_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/snap_to_button_label" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/shift_arrow_label"
            android:textSize="16sp" />

        <RadioGroup
            android:id="@+id/radio_shift_arrow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <RadioButton
                android:id="@+id/radio_shift_fine"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/shift_arrow_fine" />

            <RadioButton
                android:id="@+id/radio_shift_scroll"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/shift_arrow_scroll" />

            <RadioButton
                android:id="@+id/radio_shift_move"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/shift_arrow_move" />
        </RadioGroup>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/ctrl_arrow_label"
            android:textSize="16sp" />

        <RadioGroup
            android:id="@+id/radio_ctrl_arrow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <RadioButton
                android:id="@+id/radio_ctrl_scroll"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/ctrl_arrow_scroll" />

            <RadioButton
                android:id="@+id/radio_ctrl_fine"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/ctrl_arrow_fine" />

            <RadioButton
                android:id="@+id/radio_ctrl_move"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/ctrl_arrow_move" />
        </RadioGroup>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/snap_delay_label"
            android:textSize="16sp" />

        <RadioGroup
            android:id="@+id/radio_snap_delay"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <RadioButton
                android:id="@+id/radio_snap_delay_500"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/snap_delay_500" />

            <RadioButton
                android:id="@+id/radio_snap_delay_1000"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/snap_delay_1000" />

            <RadioButton
                android:id="@+id/radio_snap_delay_1500"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/snap_delay_1500" />

            <RadioButton
                android:id="@+id/radio_snap_delay_2000"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/snap_delay_2000" />
        </RadioGroup>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/snap_radius_label"
            android:textSize="16sp" />

        <SeekBar
            android:id="@+id/seek_snap_radius"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <TextView
            android:id="@+id/text_snap_radius_value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/switch_glide"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/glide_label" />

        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/switch_numpad_mouse"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/numpad_mouse_label" />

        <Button
            android:id="@+id/button_reset_defaults"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/reset_defaults_button" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/language_label"
            android:textSize="16sp" />

        <RadioGroup
            android:id="@+id/radio_language"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <RadioButton
                android:id="@+id/radio_language_system"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/language_system" />

            <RadioButton
                android:id="@+id/radio_language_english"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/language_english" />

            <RadioButton
                android:id="@+id/radio_language_bengali"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/language_bengali" />
        </RadioGroup>

    </LinearLayout>
</ScrollView>
